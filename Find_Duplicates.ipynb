import re
import pandas as pd

IN_PATH  = "autism_ai_screening_sheet_ALL168.xlsx"
OUT_PATH = "duplicates_report_improved.xlsx"

# -----------------------------
# Helpers
# -----------------------------
def normalize_doi(doi: str) -> str:
    if not isinstance(doi, str):
        return ""
    doi = doi.strip().lower()
    doi = re.sub(r"^https?://(dx\.)?doi\.org/", "", doi)
    doi = doi.rstrip(" .;,)")
    return doi

def normalize_title(title: str) -> str:
    if not isinstance(title, str):
        return ""
    t = title.lower()
    t = re.sub(r"[^a-z0-9]+", " ", t)
    t = re.sub(r"\s+", " ", t).strip()
    return t

# -----------------------------
# Load data
# -----------------------------
df = pd.read_excel(IN_PATH, sheet_name="Screening")

for col in ["DOI", "PMID", "Title"]:
    if col not in df.columns:
        raise ValueError(f"Missing required column: {col}")

# Normalize
df["DOI_norm"] = df["DOI"].apply(normalize_doi)
df["PMID_norm"] = df["PMID"].astype(str).replace("nan", "").str.strip()
df["Title_norm"] = df["Title"].apply(normalize_title)

# -----------------------------
# NEW: Better duplicate detection
# -----------------------------

# Duplicate by DOI
dup_by_doi = df["DOI_norm"].ne("") & df.duplicated("DOI_norm", keep=False)

# Duplicate by PMID
dup_by_pmid = (
    df["PMID_norm"].ne("") &
    df["PMID_norm"].ne("0") &
    df.duplicated("PMID_norm", keep=False)
)

# Duplicate by TITLE (VERY IMPORTANT)
dup_by_title = df["Title_norm"].ne("") & df.duplicated("Title_norm", keep=False)

# Combine all
df["IsDuplicate"] = dup_by_doi | dup_by_pmid | dup_by_title

# -----------------------------
# Group duplicates
# -----------------------------
dup_groups = df[df["IsDuplicate"]].copy()

dup_groups["DuplicateGroupID"] = (
    dup_groups.groupby(["Title_norm"])
    .ngroup()
    .apply(lambda x: f"D{str(x+1).zfill(4)}")
)

# Count per group
dup_counts = (
    dup_groups.groupby("DuplicateGroupID")
    .size()
    .reset_index(name="Count")
    .sort_values("Count", ascending=False)
)

# Merge count
dup_groups = dup_groups.merge(dup_counts, on="DuplicateGroupID", how="left")

# Sort
dup_groups = dup_groups.sort_values(
    ["Count", "DuplicateGroupID"],
    ascending=[False, True]
)

# -----------------------------
# Save
# -----------------------------
with pd.ExcelWriter(OUT_PATH, engine="openpyxl") as writer:
    df.to_excel(writer, index=False, sheet_name="AllRecords_WithFlags")
    dup_groups.to_excel(writer, index=False, sheet_name="Duplicates_Grouped")
    dup_counts.to_excel(writer, index=False, sheet_name="Duplicate_Summary")

print("Saved improved duplicate report to:", OUT_PATH)

# -----------------------------
# Count duplicates
# -----------------------------
n_true = df["IsDuplicate"].sum()
print("Number of duplicates detected:", n_true)
